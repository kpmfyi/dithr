{
  "name": "dithr",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 127.0.0.1 --port 5187",
    "build": "npm run build:consumer && npm run build:export && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:static": "npm run build:consumer && npm run build:export && SEEDBANK_STATIC_EXPORT=1 WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "deploy:cloudflare": "npm run build:static && WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --config .local/cloudflare.json",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start --hostname 127.0.0.1 --port 9466",
    "preview:static": "node scripts/serve-static.mjs dist/client 5190",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "build:consumer": "vite build --config vite.consumer.config.ts",
    "dev:consumer": "vite --config vite.consumer.config.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build",
    "batch": "node --experimental-strip-types scripts/batch.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:workbench": "node scripts/check-workbench.mjs",
    "test:palettes": "node --experimental-strip-types scripts/check-palettes.mjs",
    "test:sharpness": "node --experimental-strip-types scripts/check-departure-sharpness.mjs",
    "test:expansion": "node scripts/check-expansion.mjs",
    "catalog:publish": "node --experimental-strip-types scripts/publish-catalog.mjs",
    "test:demos": "node --experimental-strip-types scripts/check-demos.mjs",
    "test:damage-display": "node --experimental-strip-types scripts/check-damage-display.mjs",
    "test:entropy-display": "node --experimental-strip-types scripts/check-entropy-display.mjs",
    "test:entropy-lifecycle": "node scripts/review-entropy.mjs",
    "test:intricacy-display": "node --experimental-strip-types scripts/check-intricacy-display.mjs",
    "test:intricacy-lifecycle": "node scripts/review-intricacy.mjs",
    "privacy:check": "node scripts/privacy-check.mjs",
    "build:research": "vite build --config vite.synthesis.config.ts",
    "test:synthesis-display": "node --experimental-strip-types scripts/check-synthesis-display.mjs",
    "test:synthesis-lifecycle": "node scripts/review-synthesis.mjs",
    "test:synthesis-coupling": "npm run build:research && node scripts/check-synthesis-coupling.mjs",
    "measure:synthesis": "node scripts/measure-synthesis.mjs",
    "build:export": "node scripts/build-export.mjs",
    "test:code-export": "npm run build:export && node --experimental-strip-types scripts/check-code-export.mjs",
    "test:palette-sizes": "node --experimental-strip-types scripts/check-palette-sizes.mjs",
    "test:studio": "node scripts/check-studio.mjs",
    "lab": "vite --config vite.lab.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@webgpu/types": "0.1.72",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "playwright-core": "1.61.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "description": "Portable animated shader recipes and an interactive study viewer",
  "exports": {
    ".": "./src/seedbank/index.ts"
  }
}
