# Optional Linux user service. Replace /path/to/dithr before use.
[Unit]
Description=Dithr studio
After=network.target

[Service]
Type=simple
WorkingDirectory=/path/to/dithr
ExecStart=/usr/bin/env npm start
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
